; The tree printer the parity harness compares with the compiler's own AST
; printer. It needs a corpus and a compiler, neither of which this repository
; carries, so `dune runtest` runs only its self-test, which checks this
; program's own plumbing and not parity; `make parity-tree` runs the
; measurement (test/parity/tree.sh) and is where the parity numbers come from.

(executable
 (name parity_tree)
 (modules parity_tree)
 (libraries jide_jasmin jasmin.jasmin jide_harness))

(rule
 (alias runtest)
 (action
  (run %{exe:parity_tree.exe} --selftest)))

; The reading of the compiler's printed intrinsic list, shared by the two
; measurements below, so both read the compiler's output the same way.

(library
 (name parity_compiler)
 (wrapped false)
 (modules compiler_help)
 (libraries unix))

; The typed-use comparison: for one file, the declaration the resolver answers
; for every typed variable use against the declaration the compiler's v_dloc
; names. It needs a corpus, which this repository does not carry, so
; `dune runtest` runs only its self-test, over small sources it builds itself;
; `make parity-uses` runs the measurement (test/parity/uses.sh) and is where
; the parity numbers come from.

(executable
 (name typed_uses)
 (modules typed_uses)
 (libraries jide_engine jide_jasmin jide_lang jide_harness unix))

; The two measurements of completion: the names completion offers against the
; resolver's scope, and what completion offers after a [#] for each
; architecture against the compiler's own intrinsic list. Each needs something
; this repository does not carry -- a corpus, and a compiler -- so `dune runtest`
; runs their self-tests only, which check the sampling, the reading of the
; compiler's message and the comparison, and never claim parity.
; `make completion-scope` and `make intrinsics` run the measurements
; (test/parity/completion_scope.sh and test/parity/intrinsics.sh) and are where
; the measured numbers come from.

(executable
 (name completion_scope)
 (modules completion_scope)
 (libraries jide_engine jide_jasmin jide_lang parity_compiler))

; The one-reference-per-typed-call harness. It needs a corpus, which this
; repository does not carry, so `dune runtest` runs only its self-test: the
; counting itself over small programs, including the cases that must fail.
; `make calls` runs the measurement over the corpus named by CORPUS. Both go
; through the same `judge`, so the self-test is the counter and not a model
; of it.

(executable
 (name calls)
 (modules calls)
 (libraries jide_engine jide_jasmin jide_lang))

(rule
 (alias runtest)
 (action
  (run %{exe:typed_uses.exe} --selftest)))

(rule
 (alias runtest)
 (action
  (run %{exe:calls.exe} --selftest)))

(rule
 (alias runtest)
 (action
  (run %{exe:completion_scope.exe} --selftest)))

(executable
 (name intrinsics)
 (modules intrinsics)
 (libraries jide_jasmin unix parity_compiler))

(rule
 (alias runtest)
 (action
  (run %{exe:intrinsics.exe} --selftest)))

; The rename round trip. It needs a corpus and a compiler, neither of which
; this repository carries, so `dune runtest` runs only its self-test: small
; projects renamed and renamed back with the linked library's check as the
; verdict, and the negative control, which plants a missed occurrence in every
; rename and must see each one. `make rename` runs the measurement over the
; corpus named by CORPUS with the compiler named by JASMINC.

(executable
 (name rename_trip)
 (modules rename_trip)
 (libraries jide_engine jide_controller jide_jasmin jide_lang unix))

(rule
 (alias runtest)
 (action
  (run %{exe:rename_trip.exe} --selftest)))

; The verdicts of uses.sh, the script behind `make parity-uses`, over a corpus
; uses.t writes itself: a passing run, the negative control failing the run,
; and a refused file. The comparison it runs is the one built here.

(cram
 (applies_to uses)
 (deps %{exe:typed_uses.exe}))

; The first-error run on mutants, and its list of known compiler defects, with
; stand-ins for the checker and the compiler: an excused defect, a stale
; entry, an unlisted crash and a copied defect.

(executable
 (name mutate)
 (modules mutate)
 (libraries parity_readers mutation_support jide_harness unix))

(cram
 (applies_to mutate-defects)
 (deps %{exe:mutate.exe}))

; The tree half over a corpus tree.t writes itself, with a stand-in for the
; release's parse-and-print, including the negative control.

(cram
 (applies_to tree)
 (deps %{exe:parity_tree.exe}))

; The parity run against the compiler or the release's record. `dune runtest`
; runs the readers' self-test and parity.t, which drives the run over a corpus
; it writes itself with stand-ins for the checker and the compiler.

(executable
 (name parity)
 (modules parity)
 (libraries parity_readers jide_harness unix))

(library
 (name parity_readers)
 (wrapped false)
 (modules readers))

(rule
 (alias runtest)
 (action
  (run %{exe:parity.exe} --selftest)))

(cram
 (applies_to parity)
 (deps %{exe:parity.exe}))
