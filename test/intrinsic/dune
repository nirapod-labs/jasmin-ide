; The arity and signature of every intrinsic against the native compiler
; (arity.ml, oracle.ml). `dune runtest` runs the library half and both
; controls with no compiler and no corpus; `make intrinsic-arity` adds the
; compiler and a corpus.

(executable
 (name arity)
 (modules arity oracle)
 (libraries jide_engine jide_jasmin jide_lang jide_harness unix))

(rule
 (alias runtest)
 (action
  (run %{exe:arity.exe})))
