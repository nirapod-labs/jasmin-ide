; The recovery mutation harness. It needs a corpus, which this repository
; does not carry, so `dune runtest` runs only its own checks and the corpus
; run is the `mutation` target of the Makefile.
;
; The tokenizer, the single-token families and the choice of sites are a
; library of their own because the first-error parity run (test/parity/mutate)
; emits the same families as files, so the two harnesses agree on what a
; single-token mutation is.

(library
 (name mutation_support)
 (wrapped false)
 (modules mutant token emit))

(executable
 (name mutation)
 (modules mutation outline isolate probe report selftest witness)
 (libraries jide_jasmin jide_lang jasmin.jasmin unix mutation_support))

(rule
 (alias runtest)
 (action
  (run %{exe:mutation.exe} --selftest)))

; verdicts.t runs the harness over a corpus it writes itself: a passing run whose
; one changed outline is proven impossible, and the negative control, a
; planted defect the run must fail on.

(cram
 (applies_to verdicts)
 (deps %{exe:mutation.exe}))
